generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Card {
  id          String   @id @default(cuid())
  nome        String
  edicao      String
  imagemUrl   String
  scryfallId  String   @unique
  ligamagicId String?
  precos      PriceHistory[]
}

model PriceHistory {
  id           String   @id @default(cuid())
  card         Card     @relation(fields: [cardId], references: [id])
  cardId       String
  preco        Float
  dataColetada DateTime @default(now())
}